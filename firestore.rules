rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    function isSignedIn() {
      return request.auth != null;
    }

    // Istiak Ahmed Enan is the owner & bootstrapped Super Admin
    function isBootstrappedAdmin() {
      return isSignedIn() && request.auth.token.email == 'enanahmed776@gmail.com';
    }

    function isAdmin() {
      return isBootstrappedAdmin() || (isSignedIn() && exists(/databases/$(database)/documents/admins/$(request.auth.uid)));
    }

    // Default deny all
    match /{document=**} {
      allow read, write: if false;
    }

    // Reports collection
    match /reports/{reportId} {
      // Public can read published reports. Admins can read all (including pending, archived)
      allow get, list: if resource.data.isPublished == true || isAdmin();

      // Citizens can submit new reports (strictly pending and unverified), or Admin can create directly
      allow create: if (
        request.resource.data.keys().hasAll(['reportId', 'type', 'title', 'division', 'district', 'contactName', 'contactPhone', 'status', 'isPublished']) &&
        (
          isAdmin() ||
          (
            request.resource.data.status == 'pending' &&
            request.resource.data.isPublished == false &&
            request.resource.data.isUrgent == false &&
            request.resource.data.isFeatured == false
          )
        )
      );

      // Only administrators can update or delete reports (approve, publish, resolve, edit, archive)
      allow update: if isAdmin();
      allow delete: if isAdmin();
    }

    // Sightings collection - Submitters provide clues, strictly private to Admins
    match /sightings/{sightingId} {
      // Anyone can submit a sighting with required fields
      allow create: if request.resource.data.keys().hasAll(['sightingId', 'reportId', 'phone', 'location', 'description']);

      // Only administrators can read, review, or update sightings
      allow read, update, delete: if isAdmin();
    }

    // Announcements collection
    match /announcements/{announcementId} {
      allow get, list: if resource.data.isPublished == true || isAdmin();
      allow write: if isAdmin();
    }

    // Admins collection
    match /admins/{adminId} {
      allow read: if isAdmin();
      allow write: if isAdmin();
    }

    // Audit logs - Immutable security trail
    match /auditLogs/{logId} {
      allow read, create: if isAdmin();
      allow update, delete: if false;
    }

    // Platform settings & CMS
    match /settings/{settingId} {
      allow get, list: if true;
      allow write: if isAdmin();
    }

    // Contact and correction requests
    match /contactRequests/{requestId} {
      allow create: if request.resource.data.keys().hasAll(['name', 'message', 'type']);
      allow read, update, delete: if isAdmin();
    }
  }
}
