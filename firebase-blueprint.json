{
  "entities": {
    "Report": {
      "title": "Report",
      "description": "Missing person, found person, lost item, or found item report",
      "type": "object",
      "properties": {
        "reportId": { "type": "string", "description": "Unique human readable ID e.g. NA-2026-000001" },
        "type": { "type": "string", "enum": ["missing_person", "found_person", "lost_item", "found_item"] },
        "category": { "type": "string" },
        "title": { "type": "string" },
        "name": { "type": "string" },
        "nickname": { "type": "string" },
        "age": { "type": "string" },
        "gender": { "type": "string" },
        "photos": { "type": "array" },
        "description": { "type": "string" },
        "division": { "type": "string" },
        "district": { "type": "string" },
        "upazila": { "type": "string" },
        "location": { "type": "string" },
        "incidentDate": { "type": "string" },
        "incidentTime": { "type": "string" },
        "clothing": { "type": "string" },
        "physicalDescription": { "type": "string" },
        "identificationMarks": { "type": "string" },
        "contactName": { "type": "string" },
        "contactPhone": { "type": "string" },
        "contactMethod": { "type": "string" },
        "status": { "type": "string", "enum": ["pending", "approved", "resolved", "rejected", "archived"] },
        "verificationStatus": { "type": "string", "enum": ["verified", "unverified", "investigating"] },
        "isPublished": { "type": "boolean" },
        "isUrgent": { "type": "boolean" },
        "isFeatured": { "type": "boolean" },
        "isDemo": { "type": "boolean" },
        "resolvedAt": { "type": "string" },
        "resolutionNote": { "type": "string" },
        "createdBy": { "type": "string" },
        "createdAt": { "type": "string" },
        "updatedAt": { "type": "string" }
      },
      "required": ["reportId", "type", "title", "division", "district", "contactName", "contactPhone", "status", "isPublished"]
    },
    "Sighting": {
      "title": "Sighting",
      "description": "User reported sighting of a missing person or found item",
      "type": "object",
      "properties": {
        "sightingId": { "type": "string" },
        "reportId": { "type": "string" },
        "name": { "type": "string" },
        "phone": { "type": "string" },
        "location": { "type": "string" },
        "district": { "type": "string" },
        "upazila": { "type": "string" },
        "date": { "type": "string" },
        "time": { "type": "string" },
        "description": { "type": "string" },
        "photo": { "type": "string" },
        "status": { "type": "string", "enum": ["new", "reviewed", "verified", "dismissed"] },
        "createdAt": { "type": "string" }
      },
      "required": ["sightingId", "reportId", "phone", "location", "description"]
    },
    "Announcement": {
      "title": "Announcement",
      "description": "Official broadcast announcement or alert",
      "type": "object",
      "properties": {
        "title": { "type": "string" },
        "description": { "type": "string" },
        "image": { "type": "string" },
        "priority": { "type": "string", "enum": ["normal", "urgent", "pinned"] },
        "isPublished": { "type": "boolean" },
        "isPinned": { "type": "boolean" },
        "createdAt": { "type": "string" },
        "expiresAt": { "type": "string" },
        "createdBy": { "type": "string" }
      },
      "required": ["title", "description", "isPublished"]
    },
    "AdminUser": {
      "title": "AdminUser",
      "description": "Registered administrator or moderator record",
      "type": "object",
      "properties": {
        "uid": { "type": "string" },
        "email": { "type": "string" },
        "name": { "type": "string" },
        "role": { "type": "string", "enum": ["super_admin", "moderator", "content_manager", "support"] },
        "createdAt": { "type": "string" }
      },
      "required": ["email", "role"]
    },
    "AuditLog": {
      "title": "AuditLog",
      "description": "Administrative actions and operations log",
      "type": "object",
      "properties": {
        "adminUid": { "type": "string" },
        "adminEmail": { "type": "string" },
        "action": { "type": "string" },
        "reportId": { "type": "string" },
        "details": { "type": "string" },
        "timestamp": { "type": "string" }
      },
      "required": ["action", "timestamp"]
    },
    "SiteSettings": {
      "title": "SiteSettings",
      "description": "CMS configuration for homepage and platform",
      "type": "object",
      "properties": {
        "heroTitle": { "type": "string" },
        "heroSubtitle": { "type": "string" },
        "heroImage": { "type": "string" },
        "aboutText": { "type": "string" },
        "founderName": { "type": "string" },
        "founderBio": { "type": "string" },
        "founderMessage": { "type": "string" },
        "founderPhoto": { "type": "string" },
        "contactEmail": { "type": "string" },
        "facebookPage": { "type": "string" },
        "facebookProfile": { "type": "string" },
        "updatedAt": { "type": "string" }
      }
    },
    "ContactRequest": {
      "title": "ContactRequest",
      "description": "Correction request, abuse report, or general inquiry",
      "type": "object",
      "properties": {
        "name": { "type": "string" },
        "email": { "type": "string" },
        "phone": { "type": "string" },
        "type": { "type": "string", "enum": ["correction", "abuse", "removal", "general"] },
        "reportId": { "type": "string" },
        "message": { "type": "string" },
        "status": { "type": "string", "enum": ["pending", "processed", "dismissed"] },
        "createdAt": { "type": "string" }
      },
      "required": ["name", "message", "type"]
    }
  },
  "firestore": {
    "/reports/{reportId}": {
      "schema": "Report",
      "description": "All public and pending reports for missing/found persons and items"
    },
    "/sightings/{sightingId}": {
      "schema": "Sighting",
      "description": "Sightings submitted by citizens, privately viewed by administrators"
    },
    "/announcements/{announcementId}": {
      "schema": "Announcement",
      "description": "Official public announcements and safety alerts"
    },
    "/admins/{adminId}": {
      "schema": "AdminUser",
      "description": "System admin documents mapped by UID or document ID"
    },
    "/auditLogs/{logId}": {
      "schema": "AuditLog",
      "description": "Audit trail of admin operations and status changes"
    },
    "/settings/{settingId}": {
      "schema": "SiteSettings",
      "description": "Platform CMS parameters and founder information"
    },
    "/contactRequests/{requestId}": {
      "schema": "ContactRequest",
      "description": "Inquiries, correction requests and abuse reports"
    }
  }
}
